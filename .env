# ----------------------------
# VPN credentials
# ----------------------------
SNX_VPN_USERNAME=testuser          # VPN username
SNX_VPN_PASSWORD=secret123         # VPN password
SNX_VPN_GETWAI=vpn.example.com     # VPN gateway / server

# ----------------------------
# SSH settings for container access
# ----------------------------
SNX_SSH_USER=jumphost               # SSH user inside the container
SNX_SSH_PASSWORD=password123        # SSH password
SNX_SSH_BIND=2222                   # Host port to bind SSH (default 2222)

# ----------------------------
# Docker container settings
# ----------------------------
SNX_IMAGE=snx                        # Docker image name
SNX_NAME=snx                         # Docker container name
